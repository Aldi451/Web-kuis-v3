# Salin file ini menjadi ".env" (di folder yang sama), lalu sesuaikan seperlunya.
# Semua baris bersifat opsional: tanpa file .env aplikasi tetap jalan dengan pengaturan bawaan.

# ---------------- Server ----------------
# Port server. Jika port ini sedang dipakai, run_server otomatis memakai port berikutnya.
APP_PORT=8000

# 0.0.0.0   = bisa dibuka dari HP / perangkat lain di WiFi yang sama (bawaan)
# 127.0.0.1 = hanya bisa dibuka dari komputer ini
APP_HOST=0.0.0.0

# Jika server dibuka lewat domain atau tunnel (ngrok, Cloudflare Tunnel, dll.),
# isi alamat publiknya agar QR code peserta memakai alamat tersebut.
# PUBLIC_URL=https://kuis.contoh.com

# ---------------- Database ----------------
# Dikosongkan = SQLite lokal (file quizdb.db), tanpa instalasi apa pun.
# Untuk PostgreSQL, isi baris berikut (library psycopg2 dipasang otomatis):
# DATABASE_URL=postgresql://postgres:password@localhost:5432/quizdb
# Paksa SQLite walaupun PostgreSQL sedang aktif di komputer ini:
# DB_BACKEND=sqlite

# ---------------- Koreksi essay dengan AI (opsional) ----------------
# Tanpa API key, essay dinilai dengan pencocokan kata kunci sederhana.
# GEMINI_API_KEY=isi_api_key_anda
# GEMINI_MODEL=gemini-flash-latest
